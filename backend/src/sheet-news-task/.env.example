# Choose service-account OR oauth.
GOOGLE_AUTH_MODE=service-account

# Service account: path to JSON key; keep the key outside source control.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# OAuth alternative: set GOOGLE_AUTH_MODE=oauth and fill these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Sheet / news configuration
GOOGLE_SHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_BLUE_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_INTELLIGENCE_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_KHMER_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_TAB=Sheet1
NEWS_DATE_COLUMN=วันที่
NEWS_IMAGE_COLUMN=รูป
NEWS_IMAGE_DIR=./downloads/news
NEWS_TIMEZONE=Asia/Bangkok
